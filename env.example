# Postgres (Supabase). Two URLs, because they are used for different things:
#
#   DATABASE_URL — the Supavisor *transaction* pooler, port 6543. This is what
#     the app runs on. Serverless functions scale out to many instances and each
#     opens its own pool, so connecting directly would exhaust the server's
#     connection slots. The pooler also answers over IPv4; Supabase's direct
#     host is IPv6-only, which Vercel cannot reach.
#
#   DIRECT_URL — the unpooled connection, port 5432. Used only by `prisma
#     migrate`, which needs a session that stays put for advisory locks and DDL.
#     Optional: without it the migration falls back to DATABASE_URL.
#
DATABASE_URL=""
DIRECT_URL=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# OpenAI
OPENAI_API_KEY=""

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# Cloudflare R2 (generated sites are deployed here — S3-compatible)
# R2_ACCOUNT_ID: your Cloudflare account id (the R2 API endpoint is
#   https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com)
R2_ACCOUNT_ID=""
# API token access key pair (R2 dashboard → Manage R2 API Tokens → Object Read & Write)
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# The bucket that holds the deployed sites
R2_BUCKET_NAME="framerate-sites"
# Public URL that serves the bucket's objects — the bucket's r2.dev subdomain
# or a custom domain you bind to the bucket. No trailing slash.
# e.g. https://pub-xxxxxxxx.r2.dev  or  https://sites.yourdomain.com
# ⚠️ Do NOT use the API endpoint (https://<account>.r2.cloudflarestorage.com) —
#    that needs SigV4 auth and browsers get "InvalidArgument / Authorization".
#    Enable the bucket's "Public Development URL" in the R2 dashboard, or bind a
#    custom domain, and paste THAT url here.
R2_PUBLIC_URL=""

# --- Code generation model ----------------------------------------------------
# The model that writes the website, and only that. Building a full page is the
# hardest job in the pipeline, so it does not share the cheap model the titles,
# chat replies and brief compiler use. It drives tools (editFiles/readFiles/
# terminal) in a loop, so it needs a model that reliably emits valid tool calls —
# a model that cannot returns finish_reason "error" and the build spins without
# writing anything. "max" is the next step up on effort if quality matters more.
CODE_AGENT_MODEL="anthropic/claude-sonnet-5"
CODE_AGENT_REASONING_EFFORT="high"

# --- Section photography ------------------------------------------------------
# Section photos are GENERATED with prunaai/p-image on Replicate (REPLICATE_API_KEY),
# about $0.005 each, several per site, run in parallel. No stock library and no
# attribution line on customer sites. Charged to the user at
# AGENT_COSTS.SECTION_IMAGE credits per image that actually renders.

# --- Local media mocking ------------------------------------------------------
# Image generation is mocked outside production so local runs never spend money.
# Point this at any public image.
MOCK_MEDIA_IMAGE_URL=""

# --- Model routing (per task) --------------------------------------------------
# Defaults live in src/lib/models.ts. Override any of these to A/B a model
# without a deploy. The brief compiler is the one that matters most: it picks
# the palette, typography and composition, so a weak model there caps quality
# no matter how strong the code agent is.
#
# code and fixer drive tools in a loop — keep them on a model that holds a tool
# contract. vision and utility do not, so they stay on the cheap tier with no
# reasoning effort (it is pure latency for a title or a chat reply).
# If a build finishes having written no files, set MODEL_CODE / MODEL_FIXER back
# to "anthropic/claude-sonnet-5" — flash-lite has previously failed to hold the
# tool contract on these two, and effort does not fix tool-call formatting.
MODEL_BRIEF="google/gemini-3.5-flash-lite"
MODEL_BRIEF_EFFORT="max"
MODEL_CODE="google/gemini-3.5-flash-lite"
MODEL_CODE_EFFORT="max"
MODEL_FIXER="google/gemini-3.5-flash-lite"
MODEL_FIXER_EFFORT="max"
MODEL_VISION="google/gemini-3.5-flash-lite"
MODEL_UTILITY="google/gemini-3.5-flash-lite"

# --- v0 Platform API -----------------------------------------------------------
# REQUIRED. Every site build runs on v0 — there is no sandbox fallback — so the
# builder cannot start a chat, stream a turn or serve a preview without this.
# Generate at v0.app settings. All calls are pinned to the v0-mini model.
V0_API_KEY=""

# --- v0 preview host (optional but strongly recommended) ---------------------
# Wildcard parent for preview subdomains, e.g. "preview.framerate.space".
# Each build is then served from <chatId>.preview.framerate.space, which lets the
# generated site live at "/" — its router works, its assets resolve, and links
# navigate client-side with no rewriting. Needs a wildcard DNS record and a
# wildcard TLS certificate. Leave unset to fall back to the same-origin path
# proxy, which works but reloads the page on every internal link.
NEXT_PUBLIC_V0_PREVIEW_HOST=""
