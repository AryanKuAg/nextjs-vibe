generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id        String   @id @default(uuid())
  name      String
  userId    String
  sandboxId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Lifecycle — "draft" until first scene is generated, then "active"
  status String @default("draft") // "draft" | "active"

  // Set when the project was started by remixing a gallery template. Null for
  // every project built from a plain prompt — the presence of this field is the
  // ONLY switch that enables the template pipeline (GitHub clone + diff edits),
  // so the manual-prompt path is unaffected by anything gated on it.
  templateId String? // matches TemplateManifest.id in src/lib/templates/registry.ts

  // v0 Platform API state. The site is built by v0 rather than an E2B sandbox,
  // so the chat is the durable handle to the build and its hosted preview.
  v0ChatId String? // persists across turns — follow-ups reuse the same chat
  // Set while a v0 run is in flight, cleared when its result is reconciled into
  // a Message + Fragment. Doubles as the idempotency key for that reconcile.
  v0PendingMessageId String?

  // Set when the user publishes. The built site is uploaded to R2 under
  // sites/<projectId>/, so this URL is stable across republishes.
  publishedUrl String?
  publishedAt  DateTime?

  // Visual pipeline state
  currentStage   String @default("SCENE") // "SCENE" | "GENERATING_SCENE" | "BUILDING_SITE" | "SITE" | "THINKING"
  sceneImageUrls Json   @default("[]") // Array of all generated scene image URLs
  prompts        Json   @default("[]") // The build brief — see SiteBrief in src/lib/v0-site-prompt.ts

  // LEGACY, no longer written or read. Left in place deliberately: these are the
  // only record of clips the removed video agent generated, and the files are
  // still in R2. Drop them with a migration once that footage is written off.
  videoUrls  Json @default("[]")
  frameCount Int?

  messages Message[]
}

enum MessageRole {
  USER
  ASSISTANT
}

enum MessageType {
  RESULT
  ERROR
  INTERACTIVE
}

model Message {
  id        String      @id @default(uuid())
  content   String
  role      MessageRole
  type      MessageType
  stage     String      @default("SITE") // "SCENE" | "VIDEO" | "SITE" — isolated chat per tab
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  fragment Fragment?
}

model Fragment {
  id        String  @id @default(uuid())
  messageId String  @unique
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  sandboxUrl    String
  deploymentUrl String?
  title         String
  files         Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Usage {
  key               String    @id
  credits           Int       @default(0)
  expire            DateTime? // End of the current paid period (next_billing_date from Dodo). Used to keep access until period end after cancellation.
  plan              String    @default("free") // "free" | "plus" | "pro" | "max"
  billing           String? // "monthly" | "yearly" — null on free
  subscriptionId    String?
  subscriptionStatus String   @default("active") // "active" | "on_hold" | "cancelled" | "failed" | "expired" — only "active" earns cron credit resets
  lastCreditResetAt DateTime  @default(now())
}
